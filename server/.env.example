NOVITA_API_KEY=your_novita_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
API_BASE_URL=https://api.novita.ai/openai/v1
API_MODEL=deepseek/deepseek-ocr
PORT=3001

# Log level: debug | info | warn | error | silent
# NODE_ENV: development (debug logs) | production (info logs only)
NODE_ENV=development
LOG_LEVEL=info

OCR_CONCURRENCY=5   # 同时处理5页
OCR_MAX_RETRIES=3       # 最大重试次数
OCR_RETRY_DELAY=2000    # 首次重试延时 (ms)

# Access Token for simple authentication (leave empty or remove to disable)
# Users must access with ?token=YOUR_TOKEN or pass X-Access-Token header
ACCESS_TOKEN=
