NOVITA_API_KEY=your_novita_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
API_BASE_URL=https://api.novita.ai/openai/v1
API_MODEL=deepseek/deepseek-ocr
PORT=3001
PDFIMAGES_BIN=pdfimages

# OpenRouter models - THIS IS THE ONLY PLACE they are defined (no fallback in code).
# Default model used when provider=openrouter
OPENROUTER_MODEL=google/gemini-3-flash-preview
# Dropdown options shown in the UI: comma separated, "vendor/model" or "vendor/model|Display Label"
OPENROUTER_MODELS=google/gemini-3-flash-preview|Gemini 3 Flash Preview,qwen/qwen3-vl-235b-a22b-instruct|Qwen3 VL 235B
# max_tokens used for OpenRouter models
OPENROUTER_MAX_TOKENS=500000
# AI post-processing model (optional, defaults to OPENROUTER_MODEL)
# POST_PROCESS_MODEL=google/gemini-3-flash-preview
# POST_PROCESS_PROVIDER=openrouter

# Log level: debug | info | warn | error | silent
# NODE_ENV: development (debug logs) | production (info logs only)
NODE_ENV=development
LOG_LEVEL=info

OCR_CONCURRENCY=5   # 同时处理5页
OCR_MAX_RETRIES=3       # 最大重试次数
OCR_RETRY_DELAY=2000    # 首次重试延时 (ms)

# Access Token for simple authentication (leave empty or remove to disable)
# Users must access with ?token=YOUR_TOKEN or pass X-Access-Token header
ACCESS_TOKEN=

PDFIMAGES_BIN=D:\xpdf-tools-win-4.06\bin64\pdfimages.exe